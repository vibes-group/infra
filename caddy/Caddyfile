# Caddy serves browser TLS direct (Let's Encrypt). No CDN in front.
# Common header set + cache rules reused per host via snippet.
#
# TLS is served on 8443 and reached over loopback, so the client address arrives in a PROXY
# header instead of on the connection. The apps rate-limit per client address and log it, so
# they need the real one.
{
	servers :8443 {
		listener_wrappers {
			proxy_protocol {
				allow 127.0.0.1/32 {$VIBES_NET_SUBNET:10.200.200.0/24}
			}
			tls
		}
		# HTTP/3 needs a UDP listener on the port the browser dials.
		protocols h1 h2
	}
}

(common_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
	}
}

(le_http01) {
	# Port 80 carries the only challenge this deployment can answer.
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
}

(spa_cache) {
	@vendor path /vendor/*
	header @vendor Cache-Control "public, max-age=31536000, immutable"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@html path / /index.html /login.html
	header @html Cache-Control "no-cache"
}

https://{$VOICE_HUB_HOST}:8443 {
	import le_http01
	encode zstd gzip
	import common_headers
	header Permissions-Policy "microphone=(self), camera=(self), display-capture=(self), geolocation=()"
	header Content-Security-Policy "default-src 'self'; connect-src 'self' wss: https:; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	import spa_cache
	reverse_proxy voice-hub-app:8080
}

https://{$SOZVON_HUB_HOST}:8443 {
	import le_http01
	encode zstd gzip
	import common_headers
	header Permissions-Policy "microphone=(self), camera=(self), display-capture=(self), geolocation=()"
	header Content-Security-Policy "default-src 'self'; connect-src 'self' wss: https:; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	import spa_cache
	reverse_proxy sozvon-hub-app:8080
}

https://{$OTS_HOST}:8443 {
	import le_http01
	encode zstd gzip
	import common_headers
	reverse_proxy ots-app:3000
}

https://{$CURRENCY_HUB_HOST}:8443 {
	import le_http01
	encode zstd gzip
	import common_headers
	header Content-Security-Policy "default-src 'self'; connect-src 'self' https:; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	import spa_cache
	root * /srv/web/currency-hub/current

	handle {
		try_files {path} /index.html
		file_server
	}
}

# Share HTTP-01 validation with host services using certbot webroot.
:80 {
	handle /.well-known/acme-challenge/* {
		root * /srv/acme
		file_server
	}
	handle {
		respond 404
	}
}
