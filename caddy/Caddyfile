# Caddy serves browser TLS direct (Let's Encrypt). No CDN in front.
# Common header set + cache rules reused per host via snippet.
{
	# The admin API's one caller is this stack's health check, whose line every thirty seconds
	# would be the whole log. Dropped from the default logger and taken back at ERROR, because a
	# config the running server rejects is reported there and nowhere else on the host.
	log default {
		exclude admin.api
	}

	log admin {
		include admin.api
		level ERROR
	}

	# The HTTP site below owns port 80 — it also answers ACME for the host and its relays — so
	# Caddy's own redirects stay out of its way.
	auto_https disable_redirects
}

(common_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
	}
}

(spa_cache) {
	@vendor path /vendor/*
	header @vendor Cache-Control "public, max-age=31536000, immutable"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@html path / /index.html /login.html
	header @html Cache-Control "no-cache"
}

{$VOICE_HUB_HOST} {
	encode zstd gzip
	import common_headers
	header Permissions-Policy "microphone=(self), camera=(self), display-capture=(self), geolocation=()"
	header Content-Security-Policy "default-src 'self'; connect-src 'self' wss: https:; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	import spa_cache
	reverse_proxy voice-hub-app:8080
}

{$SOZVON_HUB_HOST} {
	encode zstd gzip
	import common_headers
	header Permissions-Policy "microphone=(self), camera=(self), display-capture=(self), geolocation=()"
	header Content-Security-Policy "default-src 'self'; connect-src 'self' wss: https:; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	import spa_cache
	reverse_proxy sozvon-hub-app:8080
}

{$OTS_HOST} {
	encode zstd gzip
	import common_headers
	reverse_proxy ots-app:3000
}

{$CURRENCY_HUB_HOST} {
	encode zstd gzip
	import common_headers
	header Content-Security-Policy "default-src 'self'; connect-src 'self' https:; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	import spa_cache
	root * /srv/web/currency-hub/current

	handle {
		try_files {path} /index.html
		file_server
	}
}

# Share HTTP-01 validation with host services using certbot webroot.
:80 {
	# A host that relays another server's services can be asked to prove an address whose
	# certificate that server holds. Caddy answers its own challenges before any route, and the
	# webroot answers the host's; a token neither knows goes to ACME_RELAY_UPSTREAM. Unset,
	# nothing is forwarded.
	@relayed_acme {
		path /.well-known/acme-challenge/*
		not file {
			root /srv/acme
		}
		expression {env.ACME_RELAY_UPSTREAM} != ""
	}
	handle @relayed_acme {
		reverse_proxy {env.ACME_RELAY_UPSTREAM}
	}

	handle /.well-known/acme-challenge/* {
		root * /srv/acme
		file_server
	}

	@apps host {$VOICE_HUB_HOST} {$SOZVON_HUB_HOST} {$OTS_HOST} {$CURRENCY_HUB_HOST}
	handle @apps {
		redir https://{host}{uri} permanent
	}

	# Anything else, the bare address included, learns nothing from us.
	handle {
		respond 404
	}
}
